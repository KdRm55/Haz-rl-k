# PostgreSQL bağlantısı (Supabase / Neon / başka bir PostgreSQL).
# Supabase: bilgisayarınızdaki komutlar (migrate, aktar, kod) için "Session pooler" (5432),
# Vercel için "Transaction pooler" (6543) adresi.
DATABASE_URL=postgres://kullanici:sifre@sunucu/veritabani?sslmode=require

# Oturum çerezini imzalamak için en az 32 karakterlik rastgele bir değer.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
